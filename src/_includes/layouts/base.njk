<!doctype html>
<html lang="en-GB" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# Pages set `title` and optionally `description` in their front matter #}
  <title>{{ title }}{% if page.url != "/" %} · {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#021034">

  <!-- Settings, then the theme is applied before the page paints (no flash) -->
  <script src="/config.js"></script>
  <script src="/js/features/theme.js"></script>
  <script src="/js/boot-theme.js"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/styles.css">

  <!-- Feature modules (deferred: run after the HTML is parsed, in this order) -->
  <script src="/js/core/utils.js" defer></script>
  <script src="/js/core/tokens.js" defer></script>
  <script src="/js/core/config-store.js" defer></script>
  <script src="/js/features/mobile-menu.js" defer></script>
  <script src="/js/features/sections.js" defer></script>
  <script src="/js/features/motion.js" defer></script>
  <script src="/js/features/design-panel.js" defer></script>
  <script src="/js/main.js" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
{% include "partials/header.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}
</body>
</html>
